# Poptek Shopify Remix app — environment template (no real secrets)
#
# Uses the same PostgreSQL DATABASE_URL as the backend within each environment.

# --- Environment identity (required on deployed hosts) ---
APP_ENV=development

# --- Database (required — no fallback) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# DATABASE_ENV_ID=staging
# EXPECTED_DATABASE_HOST_MARKER=your-staging-supabase-ref

# --- Shopify app credentials (set per environment in Railway) ---
# Production Client ID: bfcae2d7ecd83eb4fc96749fb543380c
# Staging Client ID:     786f52ea5cd6c4e9c95a835dfecd2ecb
SHOPIFY_API_KEY="replace_me"
SHOPIFY_API_SECRET="replace_me"

# Public URL of THIS Remix service (Railway)
APP_URL="http://localhost:3000"
SHOPIFY_APP_URL="http://localhost:3000"

# Implux admin dashboard (Open Dashboard link)
FRONTEND_URL="http://localhost:5173"

# Backend sync + compliance forward (must match backend MERCHANT_SYNC_SECRET)
MERCHANT_SYNC_SECRET="replace_me"
IMPLUX_BACKEND_URL="http://localhost:3001"

# Scopes — must match shopify.app.production.toml / shopify.app.staging.toml
# Note: read_users is only needed if IMPLUX_DASHBOARD_ALLOWED_EMAILS is set (Open Campaigns allowlist uses currentStaffMember GraphQL).
SCOPES="read_products,write_script_tags,read_orders,write_themes,read_themes"

# Optional post-install theme editor redirect
# THEME_EXTENSION_ID=""

# IMPLUX_DASHBOARD_ALLOWED_EMAILS="admin@example.com"

# --- Side effects ---
# Staging/preview/development default EMAIL_ENABLED=false (no accidental real recipients)
# EMAIL_ENABLED=false
# OVERLAY_REQUEST_TO="staging-team@example.com"

# --- Zoho SMTP (production only when EMAIL_ENABLED=true) ---
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM="Implux Requests <notifications@example.com>"

# --- Theme extension build (deploy scripts) ---
# POPTEK_PROXY_URL=https://api-staging.implux.io/proxy   # staging deploy
# POPTEK_PROXY_URL=https://api.implux.io/proxy             # production deploy
