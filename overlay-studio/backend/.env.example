# Implux / Poptek backend — environment template (no real secrets)
#
# Copy to .env for local development. Production/staging values live in Railway only.

# --- Environment identity (required on deployed hosts) ---
# development | preview | staging | production
APP_ENV=development

# --- Database (required — no fallback) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Phase 2B: set to production | staging | preview | development to match APP_ENV
# DATABASE_ENV_ID=staging
# Optional non-secret host/project marker validated in non-production (Phase 2B)
# EXPECTED_DATABASE_HOST_MARKER=your-staging-supabase-ref

# --- Auth ---
JWT_SECRET="replace_me"

# --- Admin dashboard CORS (comma-separated origins) ---
# production: https://admin.implux.io
# staging: https://admin-staging.implux.io
# development: http://localhost:5173
FRONTEND_URL="http://localhost:5173"

PORT=3001

# --- Shopify (production public app shown; use staging Client ID on staging backend) ---
# Production Client ID: bfcae2d7ecd83eb4fc96749fb543380c
# Staging Client ID:     786f52ea5cd6c4e9c95a835dfecd2ecb
SHOPIFY_API_KEY="replace_me"
SHOPIFY_API_SECRET="replace_me"

# Server-to-server secret shared with Shopify Remix app (must match on both services)
MERCHANT_SYNC_SECRET="replace_me"

# App proxy HMAC (optional — theme extension calls API directly today)
PROXY_HMAC_SECRET="replace_me"

# --- Side effects ---
# Production default: enabled when unset. Staging/preview/development default: disabled.
# RAKUTEN_SYNC_ENABLED=true
# EMAIL_ENABLED is backend-only for future use; Rakuten cron lives here.

# --- Rakuten Advertising (optional) ---
RAKUTEN_CLIENT_ID=""
RAKUTEN_CLIENT_SECRET=""
RAKUTEN_PUBLISHER_ID=""
RAKUTEN_SECURITY_TOKEN=""

# --- OpenAI (optional — Conversion Intelligence falls back to heuristics without a key) ---
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Diagnostics ---
# COMPLIANCE_WEBHOOK_DEBUG=false
