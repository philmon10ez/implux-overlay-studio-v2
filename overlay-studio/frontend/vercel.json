{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://implux-overlay-studio-v2-staging.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!assets/|favicon|api/).*)",
      "destination": "/index.html"
    }
  ]
}
