# Poptek admin frontend — environment template (no real secrets)
#
# Vite exposes only VITE_* variables to the browser.

# --- Environment identity (required for production/staging/preview builds) ---
# development | preview | staging | production
VITE_APP_ENV=development

# --- API base URL (required — no production fallback) ---
# production:  https://api.implux.io
# staging:     https://api-staging.implux.io
# development: http://localhost:3001
VITE_API_URL=http://localhost:3001

# Optional — quick links on Campaigns tab for Shopify dev testing
# VITE_SHOPIFY_DEV_STORE=your-store.myshopify.com
# VITE_SHOPIFY_THEME_EXTENSION_ID=gid://shopify/ThemeAppExtension/123456789
